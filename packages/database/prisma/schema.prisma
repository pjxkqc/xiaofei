datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client"
  output     = "./generated"
  engineType = "client"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "./zod"
  config   = "./zod-generator.config.json"
}

model User {
  id                       String                       @id @default(cuid())
  name                     String
  email                    String
  emailVerified            Boolean
  image                    String?
  createdAt                DateTime
  updatedAt                DateTime
  role                     String?
  banned                   Boolean?
  banReason                String?
  banExpires               DateTime?
  onboardingComplete       Boolean                      @default(false)
  paymentsCustomerId       String?
  locale                   String?
  twoFactorEnabled         Boolean?
  lastActiveOrganizationId String?
  sessions                 Session[]
  accounts                 Account[]
  passkeys                 Passkey[]
  invitations              Invitation[]
  purchases                Purchase[]
  members                  Member[]
  twofactors               TwoFactor[]
  notifications            Notification[]
  notificationPreferences  UserNotificationPreference[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  activeOrganizationId String?

  token     String
  createdAt DateTime
  updatedAt DateTime

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id           String    @id @default(cuid())
  accountId    String
  providerId   String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  idToken      String?   @db.Text
  expiresAt    DateTime?
  password     String?

  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime

  createdAt DateTime?
  updatedAt DateTime?

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model TwoFactor {
  id          String  @id @default(cuid())
  secret      String
  backupCodes String
  verified    Boolean @default(false)
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Organization {
  id                 String       @id @default(cuid())
  name               String
  slug               String?
  logo               String?
  createdAt          DateTime
  metadata           String?
  paymentsCustomerId String?
  members            Member[]
  invitations        Invitation[]
  purchases          Purchase[]
  xiaofeiConfig      XiaofeiOrganizationConfig?
  xiaofeiCustomers   XiaofeiCustomer[]
  xiaofeiChannelBindings XiaofeiChannelBinding[]
  knowledgeUnitRevisions XiaofeiKnowledgeUnitRevision[]
  capabilityVersions XiaofeiCapabilityVersion[]
  capabilityBindings XiaofeiCapabilityBinding[]
  responseInterventions XiaofeiResponseIntervention[]

  @@unique([slug])
  @@map("organization")
}

model XiaofeiOrganizationConfig {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalMerchantId String?      @unique
  xiaofeiEnabled     Boolean      @default(false)
  emailDeliveryMode  String       @default("mock")
  emailCallbackUrl   String?      @db.Text
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("xiaofei_organization_config")
}

model XiaofeiCustomer {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalCustomerId String
  name               String?
  email              String?
  whatsappNumber     String?
  status             String       @default("active")
  lastSeenAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  conversations XiaofeiConversation[]

  @@unique([organizationId, externalCustomerId])
  @@unique([organizationId, id])
  @@index([organizationId, updatedAt])
  @@map("xiaofei_customer")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum PurchaseType {
  SUBSCRIPTION
  ONE_TIME
}

model Purchase {
  id             String        @id @default(cuid())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String?
  type           PurchaseType
  customerId     String
  subscriptionId String?       @unique
  priceId        String
  status         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([subscriptionId])
  @@map("purchase")
}

enum NotificationTarget {
  IN_APP
  EMAIL
}

enum NotificationType {
  WELCOME
  APP_UPDATE
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  data      Json             @default("{}")
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@map("notification")
}

model UserNotificationPreference {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  target    NotificationTarget
  createdAt DateTime           @default(now())

  @@unique([userId, type, target])
  @@map("user_notification_preference")
}

model XiaofeiWorkspace {
  id        String   @id @default(cuid())
  tenantKey String   @unique
  snapshot  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations      XiaofeiConversation[]
  knowledgeDocuments XiaofeiKnowledgeDocument[]
  knowledgeEntries   XiaofeiKnowledgeEntry[]
  knowledgeUnits     XiaofeiKnowledgeUnit[]
  inboundEvents      XiaofeiInboundEvent[]
  channelBindings    XiaofeiChannelBinding[]
  conversationMessages XiaofeiConversationMessage[]
  processingJobs     XiaofeiProcessingJob[]
  outboundDeliveries XiaofeiOutboundDelivery[]

  @@map("xiaofei_workspace")
}

model XiaofeiConversation {
  id                 String           @id @default(cuid())
  workspaceId        String
  workspace          XiaofeiWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  externalId         String
  customerId         String?
  customer           XiaofeiCustomer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  channel            String           @default("public_support")
  customerName       String?
  status             String           @default("open")
  assignedUserId     String?
  assignedUserName   String?
  state              Json
  messages           Json             @default("[]")
  traceEvents        Json             @default("[]")
  lastCustomerSeenAt DateTime?
  lastMessageAt      DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  conversationMessages XiaofeiConversationMessage[] @relation("MessageConversation")
  processingJobs     XiaofeiProcessingJob[] @relation("JobConversation")
  outboundDeliveries XiaofeiOutboundDelivery[] @relation("DeliveryConversation")

  @@unique([workspaceId, externalId])
  @@unique([workspaceId, id])
  @@index([workspaceId])
  @@index([workspaceId, updatedAt])
  @@index([customerId])
  @@map("xiaofei_conversation")
}

model XiaofeiChannelBinding {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId      String
  workspace        XiaofeiWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyId        String
  channel          String
  channelAccountId String
  address          String
  status           String           @default("active")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([companyId, channel, channelAccountId])
  @@unique([companyId, channel, address])
  @@index([workspaceId, status])
  @@index([organizationId, status])
  @@map("xiaofei_channel_binding")
}

model XiaofeiInboundEvent {
  id              String           @id @default(cuid())
  workspaceId     String
  workspace       XiaofeiWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source          String
  eventId         String
  schemaVersion   String
  transportKind   String
  topic           String?
  partition       Int?
  offset          String?
  messageKey      String?
  eventType       String
  occurredAt      DateTime
  payload         Json
  payloadHash     String
  safeHeaders     Json             @default("{}")
  status          String           @default("accepted")
  deliveryCount   Int              @default(1)
  firstReceivedAt DateTime         @default(now())
  lastReceivedAt  DateTime         @default(now())
  processedAt     DateTime?
  lastError       String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  conversationMessage XiaofeiConversationMessage? @relation("MessageInboundEvent")
  processingJobs     XiaofeiProcessingJob[] @relation("JobInboundEvent")

  @@unique([workspaceId, source, eventId])
  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt, id])
  @@index([workspaceId, source, createdAt, id])
  @@index([workspaceId, status, createdAt, id])
  @@index([workspaceId, topic, createdAt, id])
  @@map("xiaofei_inbound_event")
}

model XiaofeiConversationMessage {
  id                 String                    @id @default(cuid())
  workspaceId        String
  workspace          XiaofeiWorkspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversationId     String
  conversation       XiaofeiConversation       @relation("MessageConversation", fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Cascade)
  inboundEventId     String                    @unique
  inboundEvent       XiaofeiInboundEvent       @relation("MessageInboundEvent", fields: [workspaceId, inboundEventId], references: [workspaceId, id], onDelete: Cascade)
  eventId            String
  sourceMessageId    String
  providerMessageId  String?
  replyToSourceMessageId String?
  direction          String
  senderType         String
  fromAddress        String
  fromName           String?
  toRecipients       Json
  subject            String?
  contentType        String
  contentValue       String                     @db.Text
  attachments        Json?
  labels             Json?
  sourceSendType     Int?
  occurredAt         DateTime
  ingestedAt         DateTime                   @default(now())
  createdAt          DateTime                   @default(now())

  processingJob XiaofeiProcessingJob?

  @@unique([workspaceId, eventId])
  @@unique([workspaceId, inboundEventId])
  @@unique([workspaceId, id])
  @@index([workspaceId, conversationId, occurredAt, id])
  @@map("xiaofei_conversation_message")
}

model XiaofeiProcessingJob {
  id                 String                    @id @default(cuid())
  workspaceId        String
  workspace          XiaofeiWorkspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inboundEventId     String
  inboundEvent       XiaofeiInboundEvent       @relation("JobInboundEvent", fields: [workspaceId, inboundEventId], references: [workspaceId, id], onDelete: Cascade)
  conversationId     String
  conversation       XiaofeiConversation       @relation("JobConversation", fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Cascade)
  conversationMessageId String                  @unique
  conversationMessage XiaofeiConversationMessage @relation(fields: [workspaceId, conversationMessageId], references: [workspaceId, id], onDelete: Cascade)
  kind               String                    @default("mirrored")
  status             String                    @default("mirrored")
  attempts           Int                       @default(0)
  ownerEpoch         Int?
  nextRunAt          DateTime?
  lastError          String?                   @db.Text
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([workspaceId, inboundEventId, kind])
  @@unique([workspaceId, conversationMessageId])
  @@unique([workspaceId, id])
  @@index([workspaceId, status, nextRunAt])
  @@map("xiaofei_processing_job")
}

model XiaofeiOutboundDelivery {
  id                 String              @id
  workspaceId        String
  workspace          XiaofeiWorkspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversationId     String
  conversation       XiaofeiConversation @relation("DeliveryConversation", fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Cascade)
  processingJobId    String?              @unique
  eventType          String
  senderType         String
  destinationMode    String
  destinationUrl     String?              @db.Text
  payload            Json
  status             String               @default("pending")
  attempts           Int                  @default(0)
  responseStatus     Int?
  lastError          String?              @db.Text
  firstAttemptAt     DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt, id])
  @@index([workspaceId, status, createdAt, id])
  @@index([workspaceId, conversationId, createdAt, id])
  @@map("xiaofei_outbound_delivery")
}

enum XiaofeiKnowledgeDocumentFileType {
  MARKDOWN
  TEXT
  DOCX
  PDF
  XLSX
}

enum XiaofeiKnowledgeDocumentSourceType {
  FILE
  WEB
  MANUAL
}

enum XiaofeiKnowledgeDocumentCategory {
  PRESALES
  POSTSALES
}

model XiaofeiKnowledgeDocument {
  id                    String                           @id @default(cuid())
  workspaceId           String
  workspace             XiaofeiWorkspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceType            XiaofeiKnowledgeDocumentSourceType @default(FILE)
  originalFileName      String?
  mimeType              String?
  fileType              XiaofeiKnowledgeDocumentFileType?
  sourceUrl             String?                          @db.Text
  fileSizeBytes         Int?
  provider              String?
  parserVersion         String?
  category              XiaofeiKnowledgeDocumentCategory
  bodyText              String                           @db.Text
  contentHash           String?
  sourceVersion         Int                              @default(1)
  fetchedAt             DateTime?
  parseStatus           String                           @default("parsed")
  parseError            String?                          @db.Text
  status                String                           @default("draft")
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt

  knowledgeEntries XiaofeiKnowledgeEntry[]

  @@unique([workspaceId, id])
  @@index([workspaceId, updatedAt])
  @@map("xiaofei_knowledge_document")
}

model XiaofeiKnowledgeEntry {
  id                String                   @id @default(cuid())
  workspaceId       String
  workspace         XiaofeiWorkspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceId          String?
  source            XiaofeiKnowledgeDocument? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceContentHash String?
  sourceVersion     Int?
  question          String                   @db.Text
  answer            String                   @db.Text
  similarQueries    String[]                 @default([])
  category          String?
  tags              String[]                 @default([])
  status            String                   @default("draft")
  entryVersion      Int                      @default(1)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([workspaceId, id])
  @@index([workspaceId, updatedAt])
  @@index([sourceId])
  @@map("xiaofei_knowledge_entry")
}

model XiaofeiKnowledgeUnit {
  id                String           @id @default(cuid())
  workspaceId       String
  workspace         XiaofeiWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceId          String
  sourceContentHash String?
  sourceVersion     Int?
  entryId           String
  entryVersion      Int
  title             String
  content           Json
  status            String           @default("draft")
  eligibility       String           @default("ineligible")
  staleReason       String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([workspaceId, id])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, sourceId])
  @@index([workspaceId, entryId])
  @@map("xiaofei_knowledge_unit")
}

/// An immutable, content-addressed snapshot of a logical knowledge unit.
/// Merchant revisions are Organization-scoped; platform baseline revisions are
/// global (`organizationId = null`) and may only be referenced after an
/// Organization-scoped query has selected them explicitly.
model XiaofeiKnowledgeUnitRevision {
  id                     String        @id @default(cuid())
  organizationId         String?
  organization           Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logicalKnowledgeUnitId String
  knowledgeUnitId        String?
  origin                 String
  revision               Int
  content                Json
  contentHash            String
  createdAt              DateTime      @default(now())

  capabilityKnowledgeUnits XiaofeiCapabilityVersionKnowledgeUnit[]
  beforeInterventions     XiaofeiResponseIntervention[] @relation("InterventionBeforeRevision")
  resultInterventions     XiaofeiResponseIntervention[] @relation("InterventionResultRevision")

  @@unique([organizationId, id])
  @@unique([organizationId, logicalKnowledgeUnitId, revision], map: "xiaofei_ku_revision_organization_logical_revision_key")
  @@unique([organizationId, logicalKnowledgeUnitId, contentHash], map: "xiaofei_ku_revision_organization_logical_hash_key")
  @@index([organizationId, logicalKnowledgeUnitId, createdAt])
  @@map("xiaofei_knowledge_unit_revision")
}

/// A frozen CA manifest. Its membership and lifecycle are never updated;
/// activation is represented only by XiaofeiCapabilityBinding.
model XiaofeiCapabilityVersion {
  id           String       @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  capabilityKey String
  status        String       @default("test")
  manifestHash  String
  createdAt     DateTime     @default(now())

  knowledgeUnits       XiaofeiCapabilityVersionKnowledgeUnit[]
  activeBindings       XiaofeiCapabilityBinding[] @relation("ActiveCapabilityVersion")
  testBindings         XiaofeiCapabilityBinding[] @relation("TestCapabilityVersion")
  beforeInterventions  XiaofeiResponseIntervention[] @relation("InterventionBeforeCapabilityVersion")
  resultInterventions  XiaofeiResponseIntervention[] @relation("InterventionResultCapabilityVersion")

  @@unique([organizationId, id])
  @@unique([organizationId, capabilityKey, manifestHash])
  @@index([organizationId, capabilityKey, createdAt])
  @@map("xiaofei_capability_version")
}

/// One Organization-local pointer per capability. Switching `active` is the
/// only mutable version lifecycle operation and is performed transactionally.
model XiaofeiCapabilityBinding {
  id                        String       @id @default(cuid())
  organizationId            String
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  capabilityKey             String
  activeCapabilityVersionId String?
  testCapabilityVersionId   String?
  activeCapabilityVersion   XiaofeiCapabilityVersion? @relation("ActiveCapabilityVersion", fields: [organizationId, activeCapabilityVersionId], references: [organizationId, id], onDelete: Restrict)
  testCapabilityVersion     XiaofeiCapabilityVersion? @relation("TestCapabilityVersion", fields: [organizationId, testCapabilityVersionId], references: [organizationId, id], onDelete: Restrict)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  @@unique([organizationId, capabilityKey])
  @@map("xiaofei_capability_binding")
}

/// Membership belongs to an Organization-local CA version. `revisionOrganizationId`
/// records whether a referenced immutable revision is merchant-owned or global,
/// allowing query code to admit only same-Organization or platform snapshots.
model XiaofeiCapabilityVersionKnowledgeUnit {
  id                     String                       @id @default(cuid())
  organizationId         String
  capabilityVersionId    String
  revisionOrganizationId String?
  knowledgeUnitRevisionId String
  role                   String                       @default("primary")
  priority               Int                          @default(0)
  capabilityVersion      XiaofeiCapabilityVersion     @relation(fields: [organizationId, capabilityVersionId], references: [organizationId, id], onDelete: Cascade)
  knowledgeUnitRevision  XiaofeiKnowledgeUnitRevision? @relation(fields: [revisionOrganizationId, knowledgeUnitRevisionId], references: [organizationId, id], onDelete: Restrict)
  createdAt              DateTime                     @default(now())

  @@unique([organizationId, capabilityVersionId, knowledgeUnitRevisionId])
  @@index([organizationId, knowledgeUnitRevisionId])
  @@map("xiaofei_capability_version_knowledge_unit")
}

/// Durable before/after record for one applied correction. It never replaces a
/// response, active CA version, or earlier immutable knowledge snapshot.
model XiaofeiResponseIntervention {
  id                        String       @id @default(cuid())
  organizationId            String
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  correction                String       @db.Text
  beforeResponse            Json?
  afterResponse             Json?
  beforeCapabilityVersionId String
  resultCapabilityVersionId String
  beforeKnowledgeRevisionId String
  resultKnowledgeRevisionId String
  beforeCapabilityVersion   XiaofeiCapabilityVersion @relation("InterventionBeforeCapabilityVersion", fields: [organizationId, beforeCapabilityVersionId], references: [organizationId, id], onDelete: Restrict)
  resultCapabilityVersion   XiaofeiCapabilityVersion @relation("InterventionResultCapabilityVersion", fields: [organizationId, resultCapabilityVersionId], references: [organizationId, id], onDelete: Restrict)
  beforeKnowledgeRevision   XiaofeiKnowledgeUnitRevision @relation("InterventionBeforeRevision", fields: [organizationId, beforeKnowledgeRevisionId], references: [organizationId, id], onDelete: Restrict)
  resultKnowledgeRevision   XiaofeiKnowledgeUnitRevision @relation("InterventionResultRevision", fields: [organizationId, resultKnowledgeRevisionId], references: [organizationId, id], onDelete: Restrict)
  createdAt                 DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@map("xiaofei_response_intervention")
}
